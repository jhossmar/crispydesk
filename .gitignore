# Root-level ignores for this monorepo (frontend/ and backend/ each have
# their own .gitignore for tool-specific ignores - this one only covers
# OS/editor junk that could show up anywhere in the tree).

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# Editors
*.swp
*.swo
.vscode/
!.vscode/extensions.json

# Logs
*.log

# Env files, wherever they might land
.env
.env.local
